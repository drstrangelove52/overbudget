DB_ROOT_PASSWORD=rootsecret
DB_PASSWORD=overbudget

# Login-Daten — vor Inbetriebnahme anpassen
APP_USERNAME=admin
APP_PASSWORD=changeme

# Passphrase für verschlüsselte Backups
GPG_PASSPHRASE=change-this-backup-passphrase

# LAN-IP der VM — wird von install.sh automatisch erkannt und gesetzt
LAN_IP=
# overbudgets feste Zuteilung aus dem Port-Schema für mehrere Apps auf
# einer VM (siehe Docker App Standard resource note)
CADDY_PORT=8082
