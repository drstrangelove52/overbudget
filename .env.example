DB_ROOT_PASSWORD=rootsecret
DB_PASSWORD=overbudget

# Login-Daten — vor Inbetriebnahme anpassen
APP_USERNAME=admin
APP_PASSWORD=changeme

# Passphrase für verschlüsselte Backups
GPG_PASSPHRASE=change-this-backup-passphrase

# LAN-IP/-Hostname der VM — werden von install.sh automatisch erkannt und
# gesetzt. Caddy braucht beide als Zertifikats-Subjekt: ohne LAN_HOSTNAME
# schlägt der TLS-Handshake fehl, sobald über den Hostnamen statt der IP
# zugegriffen wird (Browser sendet dann SNI = Hostname, das zur IP-only-
# Zertifikat nicht passt).
LAN_IP=
LAN_HOSTNAME=
